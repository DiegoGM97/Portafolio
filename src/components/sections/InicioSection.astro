---
import { Icon } from "astro-icon/components";
---

<section
	id="inicio"
	class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden rounded-2xl"
>
	<div class="absolute inset-0 z-0">
		<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-125 w-125 rounded-full bg-blue-500/10 blur-[100px]"></div>
		<div class="absolute left-1/4 top-1/3 h-75 w-75 rounded-full bg-cyan-500/10 blur-[80px]"></div>
		<div class="absolute right-1/4 bottom-1/3 h-75 w-75 rounded-full bg-blue-400/10 blur-[60px]"></div>
	</div>

	<div class="relative z-10 text-center px-4">


		<h1 class="text-5xl font-black tracking-tight text-slate-100 md:text-7xl lg:text-8xl">
			<span class="block text-6xl text-blue-400/60 ">Hola, soy</span>
			<span class="block">Diego <strong class="text-blue-400">Garcia</strong></span>
			
		</h1>

		<div class="mt-6 flex items-center justify-center gap-2 text-xl font-medium text-slate-400 md:text-2xl">
			<span class="h-px w-8 bg-linear-gradient-to-r from-transparent to-blue-500/50"></span>
			<span class="font-mono text-blue-400">&lt;Frontend Developer /&gt;</span>
			<span class="h-px w-8 bg-linear-gradient-to-l from-transparent to-blue-500/50"></span>
		</div>

		<p class="mx-auto mt-8 max-w-2xl text-lg text-slate-400 leading-relaxed">
			Construyo interfaces web rapidas, accessibles y con excelente experiencia de usuario.
			Especializado en <span class="text-blue-400 font-semibold">React</span>, <span class="text-blue-400 font-semibold">Next.js</span> y <span class="text-blue-400 font-semibold">TypeScript</span>.
		</p>

		<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
			<a href="#proyectos" class="btn-primary">

				Ver proyectos
			</a>
			<a href="#contacto" class="btn-secondary">

				Contactame
			</a>
			<a href="/CV_Diego_Alexander_Garcia_Mendoza.pdf" download class="btn-primary">

				Descargar CV
			</a>
		</div>

		<div class="mt-12 flex items-center justify-center gap-6">
			<a href="https://github.com/DiegoGM97" target="_blank" rel="noopener noreferrer" class="icon-glow rounded-xl border border-blue-500/20 bg-blue-500/10 p-3 text-slate-400 transition-all hover:border-blue-400/40 hover:text-blue-400">
				<Icon name="simple-icons:github" class="h-8 w-8" />
			</a>
			<a href="https://www.linkedin.com/in/diego-alexander-garcia-mendoza-a32a0832a/" target="_blank" rel="noopener noreferrer" class="icon-glow rounded-xl border border-blue-500/20 bg-blue-500/10 p-3 text-slate-400 transition-all hover:border-blue-400/40 hover:text-blue-400">
				<Icon name="simple-icons:linkedin" class="h-8 w-8" />
			</a>
		</div>

		<div class="mt-16 animate-bounce">
			<a href="#sobre-mi" class="flex flex-col items-center gap-2 text-sm text-slate-500 transition-colors hover:text-blue-400">
				<span>Scroll</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 5v14M19 12l-7 7-7-7"/>
				</svg>
			</a>
		</div>
	</div>
</section>